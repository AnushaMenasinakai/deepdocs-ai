# Set your MongoDB Atlas connection string locally; never commit credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority #YOUR_REAL_MONGODB_ATLAS_CONNECTION_STRING
MONGODB_DB_NAME=deepdocs_ai

# Optional additional CORS origins, comma-separated, with no trailing slash.
# Example: https://app.example.com,https://preview.example.com:8443
# Existing localhost:5173 and 127.0.0.1:5173 origins remain enabled.
CORS_FRONTEND_ORIGINS=

# Replace locally with a cryptographically random secret (at least 32 bytes).
JWT_SECRET_KEY=<replace-with-a-strong-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Authentication protection. Single process only; state resets on restart.
# IP limits use ASGI client identity: verify Uvicorn/proxy trusted addresses.
# Never trust arbitrary forwarded headers or configure wildcard proxy trust.
# Positive integers; invalid values fail validation. Defaults are not load-tested.
# Concurrency 1-8; IP burst/refill 1-1000; account burst/refill 1-100.
AUTH_PASSWORD_MAX_CONCURRENT=2
AUTH_LOGIN_IP_BURST=10
AUTH_LOGIN_IP_REFILL_PER_MINUTE=20
AUTH_LOGIN_ACCOUNT_BURST=5
AUTH_LOGIN_ACCOUNT_REFILL_PER_MINUTE=1
# Registration burst 1-100; hourly refill 1-1000.
AUTH_REGISTER_IP_BURST=3
AUTH_REGISTER_IP_REFILL_PER_HOUR=5
# Entries 2-65536; idle seconds 60-86400. Only full idle buckets expire.
AUTH_LIMITER_MAX_ENTRIES=4096
AUTH_LIMITER_IDLE_SECONDS=3600

# JSON request body limit: integer bytes, 16384–1048576.
# Process environment overrides this file; default is 65536 (64 KiB).
JSON_MAX_BODY_BYTES=65536

# Maximum PDF bytes; defaults to 10 MiB.
DOCUMENT_MAX_UPLOAD_BYTES=10485760

# Page-bounded chunking and conservative processing safety limits.
PDF_CHUNK_TARGET=1000
PDF_CHUNK_OVERLAP=150
PDF_MAX_PAGES=1000
PDF_MAX_TEXT_CHARACTERS=5000000
PDF_MAX_CHUNKS=20000

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=deepdocs_chunks

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
RAG_MIN_RELEVANCE_SCORE=0.50
# Additional evidence only after the primary relevance gate passes.
RAG_MIN_EVIDENCE_SCORE=0.30
RAG_MAX_CONTEXT_CHARS=12000
