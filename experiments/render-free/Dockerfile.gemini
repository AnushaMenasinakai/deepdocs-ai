# Experiment-only image: same pinned dependencies, no local-model packaging/download.
FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
WORKDIR /app/backend
COPY backend/requirements.txt backend/docker/requirements-cpu.txt ./
RUN test "$(dpkg --print-architecture)" = amd64 \
 && python -c "import pathlib,re; pins=[l for l in pathlib.Path('requirements-cpu.txt').read_text().splitlines() if l and not l.startswith('#')]; assert len(pins)==2 and all(re.search(r'#sha256=[0-9a-f]{64}(?= ;)',l) for l in pins)" \
 && python -m pip install --no-cache-dir --only-binary=:all: -r requirements-cpu.txt -r requirements.txt \
 && python -m pip check
COPY backend/*.py ./
COPY backend/tests/*.py /tmp/suite/backend/tests/
COPY experiments/render-free/*.py /experiment/
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
ENV PYTHONPATH=/app/backend:/experiment:/tmp/suite/backend/tests
USER 10001:10001
ENTRYPOINT ["python", "/experiment/gemini_application_probe.py"]
